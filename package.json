{
  "name": "germinawiki",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test": "vitest run --config frontend/vite.config.ts --passWithNoTests",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@blocknote/ariakit": "~0.55.0",
    "@blocknote/core": "~0.55.0",
    "@blocknote/react": "~0.55.0",
    "diff": "^9.0.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
